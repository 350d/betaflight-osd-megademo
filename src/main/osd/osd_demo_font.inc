/* The demo font: character map and 5×8 letter bits */
#define OSD_DEMO_FONT_W 5
#define OSD_DEMO_FONT_H 8
#define OSD_DEMO_FONT_GLYPHS 128
#define OSD_DEMO_FONT_BYTES_PER_GLYPH 8
#define OSD_DEMO_FONT_ADVANCE (OSD_DEMO_FONT_W + 1)
// NVM layout: the whole demo font is written once at the demo start (the user's Betaflight font
// is kept in the AT7456's upper 256 glyphs meanwhile and comes back at the stop), no glyph is
// written at a scene change. 0x20 = all clear; 0xFF ends auto-increment runs (unused).
//   0x00..0x1F, 0x21..0x27  3-colour set (39): four 3-px columns black / clear / white (+ INV)
//   0x28..0x37  grey set: runs and two-run patterns (16)
//   0x38..0x3B, 0x57..0x5B, 0x5F..0x62  three-colour cell lines (13): black / clear / white,
//               osdDemoGrey3Pat
//   0x3C..0x56  6×6-dot masks (27): those the texts use (scene 1's titles, scene 3's scroller)
//   0x5C..0x5E  dither ladder of scenes 2 and 3, its top (3): 75, 89, 100 % (1..4 = the effect
//               set's dithers)
//   0x63..0x82  2-px columns: 32 black / white (+ INV) (scenes 6, 7, 9, 13)
//   0x83..0x8E  peak marks (12): white columns j, j + 1 (j = 11: column 11 alone) on black (scene 10)
//   0x90..0xBE  effect set (47): off, 18 fills, 2 × 12 star frames, 4 dithers
//   0xBF..0xDF  1-px partial cells (33): k white | black, k clear | black, k black | clear (+ INV)
//   0xE0..0xFB  grey set (28): six 2-px columns, clear (the VM1 grey) on black (INV: on white),
//               by family — see OSD_DEMO_GREY_* (all clear = 0x20)
//   0xFC..0xFE, 0x8F  grey set's edges 2 / 4 px (4)
#define OSD_DEMO_PIXEL_OFF     0x90
#define OSD_DEMO_FILL_BASE     0x91
#define OSD_DEMO_STAR2_BASE    0xA3
#define OSD_DEMO_STAR3_BASE    0xAF
#define OSD_DEMO_PLASMA_BASE   0xBB
#define OSD_DEMO_PLASMA_GLYPHS 4
#define OSD_DEMO_CLEAR         0x20 // all clear (the space)
#define OSD_DEMO_S1_MP_BASE    0x3C
#define OSD_DEMO_S1_MP_SLOTS   27   // the masks the texts use (osdDemoS1TitleGlyphs), the rest by INV / 2-px columns
#define OSD_DEMO_PLASMA8_BASE  0x5C // ladder levels 5..7 at BASE + level − 5 (osdDemoLadderGlyph)
#define OSD_DEMO_BM_BASE       0x63
#define OSD_DEMO_BM_GLYPHS     32
// Grey set: 6-bit masks of 2-px columns (bit 5 = the left one) clear, the rest black — INV makes
// the rest white, the clear stays: every pattern of grey on one colour that a 4×4 ordered dither
// of a smooth picture makes (99.97 % of scene 13's plasma cell lines; tools: statistics of the
// plasma). Families, k = the first clear column from the left:
#define OSD_DEMO_PEAK_BASE     0x83 // 12: the analyser's peak marks (scene 10)
#define OSD_DEMO_PEAK_GLYPHS   12
#define OSD_DEMO_GREY_BASE     0xE0
#define OSD_DEMO_GREY_GLYPHS   28
#define OSD_DEMO_GREY_DOT1     0  // 6: one clear column k
#define OSD_DEMO_GREY_HOLE1    6  // 6: all clear but column k
#define OSD_DEMO_GREY_DOT2S2   12 // 4: clear k, k + 2
#define OSD_DEMO_GREY_HOLE2S2  16 // 4: all clear but k, k + 2
#define OSD_DEMO_GREY_DOT2S4   20 // 2: clear k, k + 4
#define OSD_DEMO_GREY_HOLE2S4  22 // 2: all clear but k, k + 4
#define OSD_DEMO_GREY_CHECK    24 // 2: clear k, k + 2, k + 4 (k = 0: 0x2A, 1: 0x15)
#define OSD_DEMO_GREY_HALF     26 // 2: left half clear, right half clear
// The edges: clear from the left 2 / 4 px, from the right 4 / 2 px (with the dots, the halves
// and the "all but one" above: every grey edge k = 1..5 of a cell line). Glyph slots outside
// the block: OSD_DEMO_GREY_EDGE0.. (0xFC..0xFE, 0x8F — the last free ones).
#define OSD_DEMO_GREY_EDGE     28 // 4
#define OSD_DEMO_GREY_RUNS     32 // from here: runs and two-run patterns (16), at OSD_DEMO_GREY_RUN_BASE
#define OSD_DEMO_GREY_RUN_BASE 0x28 // 0x28..0x37 (the deleted half-cell scene's set was there)
#define OSD_DEMO_GREY_ALL      48 // patterns of the set in all (masks; glyph codes: osdDemoGreyCodeAt)
#define OSD_DEMO_XFILL_W_BASE  0xBF // 11: left k px white, black right (INV: black | white)
#define OSD_DEMO_XFILL_C_BASE  0xCA // 11: left k px clear, black right (INV: clear | white)
#define OSD_DEMO_XFILL_CT_BASE 0xD5 // 11: left k px black, clear right (INV: white | clear)
#define OSD_DEMO_PX22_COLS     6    // 12px / 2
#define OSD_DEMO_SOFT_STEPS    18
#define OSD_DEMO_STAR_FRAMES   12
